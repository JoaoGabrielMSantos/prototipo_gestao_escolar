# --------------------------------------------------------------------
# Copy to .env.local (never commit it). Values come from the Supabase
# dashboard (Project settings > API) or from `supabase start` for local.
#
# Anything prefixed with VITE_ is bundled into the browser build.
# Only put PUBLIC values here.
# --------------------------------------------------------------------

# Project URL. Local default from `supabase start`:
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Anon (public) key. Safe in the client: every request it makes is still
# evaluated against Row Level Security with the logged-in user's JWT.
VITE_SUPABASE_ANON_KEY=your-anon-key

# --------------------------------------------------------------------
# NOT USED BY THE FRONTEND.
# The service role key bypasses RLS entirely. It must never be prefixed
# with VITE_, never be imported by src/, and never be used in the
# isolation tests — a test that bypasses RLS proves nothing.
# Keep it only in server-side contexts (CI secrets, edge functions).
# --------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=

# Local Postgres connection, used by the SQL isolation test:
#   psql "$DATABASE_URL" -f supabase/tests/tenant_isolation.sql
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
